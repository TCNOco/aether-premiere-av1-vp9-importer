<?xml version="1.0" encoding="UTF-8"?>
<!--
  Панель Aether для Premiere Pro.

  Без неё узнать, что плагин установлен, можно только одним способом: бросить
  файл на таймлайн и посмотреть, открылся ли. Пункт в меню «Расширения» —
  единственная дверь, которую Adobe оставляет плагину для разговора с человеком:
  импортёр в меню попасть не может, у его интерфейса такого попросту нет.

  Панель НЕ подменяет собой Aether.exe и не должна. Диагностика нужна ровно
  тогда, когда Premiere не запускается, — а панель внутри Premiere в этот
  момент бесполезна. Здесь удобство, там опора.
-->
<!--
  Номер версии здесь стоит 0.0.0 НАРОЧНО. Настоящий подставляет
  installer\make-panel.ps1, беря его из собранного Aether.prm — там он один
  на весь проект. Написанный тут руками рано или поздно разошёлся бы с
  остальными, и разошёлся бы молча.

  Если панель ставится напрямую из этой папки (для разработки), 0.0.0 так
  и останется — и это правильно: сразу видно, что сборка не релизная.
-->
<ExtensionManifest Version="7.0"
    ExtensionBundleId="com.nehade.aether"
    ExtensionBundleVersion="0.0.0"
    ExtensionBundleName="Aether"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <ExtensionList>
    <Extension Id="com.nehade.aether.panel" Version="0.0.0"/>
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <!-- PPRO 14.0 — это Premiere Pro 2020. Ниже CEP 9 уже не тот, а сам
           плагин проверен от 2019 до 2026; панель — приятное дополнение,
           и терять на ней поддержку старых версий не жалко. -->
      <Host Name="PPRO" Version="[14.0,99.9]"/>
    </HostList>
    <LocaleList>
      <Locale Code="All"/>
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="9.0"/>
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.nehade.aether.panel">
      <DispatchInfo>
        <Resources>
          <MainPath>./client/index.html</MainPath>
          <CEFCommandLine>
            <!-- Node нужен по делу: панель читает файл настроек и запускает
                 AetherDiagnose.exe. Распаковывать видео на HTML нельзя ни
                 в каком виде, поэтому проверку делает та же программа, что
                 и окно, а панель только показывает её ответ.
                 mixed-context оставляем: без него require() в main.js не
                 работает. Привилегия узкая — CSP в index.html режет чужие
                 скрипты, а DOM собирается через textContent, не innerHTML. -->
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Aether</Menu>
          <Geometry>
            <Size><Height>640</Height><Width>420</Width></Size>
            <MinSize><Height>360</Height><Width>320</Width></MinSize>
          </Geometry>
          <Icons>
            <Icon Type="Normal">./client/icons/icon.png</Icon>
            <Icon Type="RollOver">./client/icons/icon.png</Icon>
            <Icon Type="DarkNormal">./client/icons/icon.png</Icon>
            <Icon Type="DarkRollOver">./client/icons/icon.png</Icon>
          </Icons>
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
