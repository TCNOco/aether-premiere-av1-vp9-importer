<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Импортёр AV1 для Adobe Premiere Pro.
    Собирается в AV1Importer.prm — это обычная Windows-DLL с другим расширением,
    которую Premiere подхватывает из папки MediaCore.

    Пути к SDK и ffmpeg заданы относительно этого файла (src/), чтобы проект
    переносился вместе с папкой и не зависел от буквы диска.
  -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <ProjectGuid>{A71C0DE1-AV11-4E01-9C0A-0000AV100001}</ProjectGuid>
    <RootNamespace>AV1Importer</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <UseDebugLibraries>false</UseDebugLibraries>
    <!-- Межмодульная оптимизация выключена намеренно: с ней линковщик
         игнорирует /DELAYLOAD, а без отложенной загрузки плагин не найдёт ffmpeg -->
    <WholeProgramOptimization>false</WholeProgramOptimization>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <UseDebugLibraries>true</UseDebugLibraries>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <PropertyGroup>
    <OutDir>$(SolutionDir)..\build\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)..\build\obj\$(Configuration)\</IntDir>
    <TargetName>AV1Importer</TargetName>
    <!-- Premiere ищет плагины-импортёры с расширением .prm -->
    <TargetExt>.prm</TargetExt>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>..\sdk\Premiere Pro 26.0 C++ SDK\Examples\Headers;..\sdk\Premiere Pro 26.0 C++ SDK\Examples\Utils;..\ffmpeg\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- ffmpeg — чистый C, заголовки требуют макросов для целочисленных констант -->
      <PreprocessorDefinitions>WIN32;_WINDOWS;_USRDLL;PRWIN_ENV;__STDC_CONSTANT_MACROS;__STDC_LIMIT_MACROS;__STDC_FORMAT_MACROS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <WarningLevel>Level3</WarningLevel>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <ConformanceMode>false</ConformanceMode>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <!-- lib-msvc — библиотеки импорта, пересобранные из .def средствами MSVC.
           Родные из поставки ffmpeg сделаны сторонним инструментом, и с ними
           линковщик молча отказывается делать отложенную загрузку (LNK4199).
           Пересоздаются командой из README при обновлении ffmpeg. -->
      <AdditionalLibraryDirectories>..\ffmpeg\lib-msvc;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies>avcodec.lib;avformat.lib;avutil.lib;swscale.lib;swresample.lib;delayimp.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <!-- Отложенная загрузка: библиотеки ffmpeg подтягиваются при первом вызове,
           уже после того как AV1Runtime.cpp загрузил их из папки плагина -->
      <DelayLoadDLLs>avcodec-62.dll;avformat-62.dll;avutil-60.dll;swscale-9.dll;swresample-6.dll;%(DelayLoadDLLs)</DelayLoadDLLs>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <Optimization>MaxSpeed</Optimization>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDebugDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="AV1Importer.cpp" />
    <ClCompile Include="AV1Decoder.cpp" />
    <ClCompile Include="AV1Runtime.cpp" />
    <ClCompile Include="AV1Settings.cpp" />
    <ClCompile Include="AV1Log.cpp" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="AV1Importer.h" />
    <ClInclude Include="AV1Decoder.h" />
    <ClInclude Include="AV1Settings.h" />
    <ClInclude Include="AV1Log.h" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="AV1Importer.rc" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
